# PostgreSQL (PostGIS extension must be enabled on this DB)
DATABASE_URL=postgresql+psycopg://neo@localhost:5432/apteka_db

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Telegram Login Widget (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Gemini (vision + normalization fallback)
GEMINI_API_KEY=

# Referent narxdan chetlanish bo'sagasi (masalan 0.20 = 20%)
PRICE_DEVIATION_THRESHOLD=0.20

# Fuzzy matching threshold (0-100, rapidfuzz score)
FUZZY_MATCH_THRESHOLD=80
FUZZY_MATCH_CONFIRM_THRESHOLD=60

CORS_ORIGINS=*
