DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*
# Productionda (masalan Railway) domeningizni ko'rsating:
# CSRF_TRUSTED_ORIGINS=https://sizning-domeningiz.up.railway.app

# Lokal ishlab chiqish uchun (Docker Postgres):
POSTGRES_DB=apteka_db
POSTGRES_USER=neo
POSTGRES_PASSWORD=neo
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Railway/production'da DATABASE_URL beriladi (Railway buni avtomatik
# qo'shadi) — berilsa, yuqoridagi POSTGRES_* o'zgaruvchilari e'tiborga olinmaydi:
# DATABASE_URL=postgresql://user:pass@host:port/dbname

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

PRICE_DEVIATION_THRESHOLD=0.20
FUZZY_MATCH_THRESHOLD=80
FUZZY_MATCH_CONFIRM_THRESHOLD=60

# Bo'sh qoldirilsa email konsolga chiqadi (lokal dev uchun yetarli).
# Haqiqiy email yuborish uchun (masalan Gmail SMTP — gmail.com'da "ilova
# parollari" bo'limidan alohida parol yarating, oddiy parolingiz ishlamaydi):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=sizning-emailingiz@gmail.com
# EMAIL_HOST_PASSWORD=ilova-paroli
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Dori Narxlari <sizning-emailingiz@gmail.com>
